# Copy to apps/web/.env.local (git-ignored). Vite reads env files from apps/web, not the repo root.

# Empty: the UI calls /api on its own origin and the dev server proxies it to http://localhost:3001.
# Set to e.g. http://localhost:3001 to call the API cross-origin (the UI's origin must be in CORS_ORIGINS).
VITE_API_URL=
