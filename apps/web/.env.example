# Copy to apps/web/.env.local (git-ignored). Vite reads env files from apps/web, not the repo root.

# Empty: the UI calls /api on its own origin and the dev server proxies it to http://localhost:3001.
# Set to e.g. http://localhost:3001 to call the API cross-origin (the UI's origin must be in CORS_ORIGINS).
VITE_API_URL=

# Match the API's CSRF_ENABLED. Off (the default): mutations carry no X-CSRF-Token and the UI never
# calls /api/csrf-token. Set to true only when the API runs with CSRF_ENABLED=true.
VITE_CSRF_ENABLED=

# Sentry (project investor-web). Empty: the SDK stays disabled. Environment defaults to the Vite mode.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
