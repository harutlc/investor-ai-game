            ],
            "url": {
              "raw": "{{baseUrl}}/api/dev/thinking/json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dev", "thinking", "json"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"system\": \"You generate reply options for a founder negotiating with an investor who offered €500k for 30%. Options must be short and distinct.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Give exactly 3 reply options.\"\n    }\n  ],\n  \"schema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"options\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"required\": [\n      \"options\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "e7ed16a0-e012-5577-bed2-c2fdd672c16b",
          "name": "Decision: tutor questions",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('csrfEnabled') !== 'false' && !pm.collectionVariables.get('csrfToken')) {",
                  "  console.warn('csrfToken is empty: run \"Session & CSRF / Get CSRF token\" first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 503 || pm.response.code === 502) {",
                  "  console.warn('Provider error ' + pm.response.json().error.code +",
                  "    ': is the active provider running? Check GET /api/health and the server log.');",
                  "}",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const { answers, provider, usage } = pm.response.json();",
                  "pm.test('provider metadata', () => {",
                  "  pm.expect(provider).to.be.oneOf(['jev', 'laya', 'fake']);",
                  "  pm.expect(usage.inputTokens).to.be.a('number');",
                  "});",
                  "pm.test('reaction is one of the labels', () => {",
                  "  pm.expect(answers.reaction.type).to.eql('choice');",
                  "  pm.expect(answers.reaction.value).to.be.oneOf(['accept', 'counter', 'reject', 'walk_away']);",
                  "  pm.expect(answers.reaction.confidence).to.be.within(0, 1);",
                  "});",
                  "pm.test('good_deal is a probability', () => pm.expect(answers.good_deal.probability).to.be.within(0, 1));",
                  "pm.test('accept is a score within the 5 levels', () => pm.expect(answers.accept.value).to.be.within(0, 4));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}",
                "description": "From \"Get CSRF token\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dev/decision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dev", "decision"]
            },
            "description": "The tutor's example: score `accept`, choice `reaction`, noul `good_deal` over one state.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": {\n    \"player_offer\": {\n      \"investment\": 500000,\n      \"equity\": 15\n    },\n    \"investor\": {\n      \"personality\": \"greedy: pushes for maximum equity, haggles long\",\n      \"budget\": 700000,\n      \"max_equity\": 30,\n      \"interest\": 0.72,\n      \"patience\": 3\n    },\n    \"history\": [\n      \"Investor offered €500k for 30%\",\n      \"Player countered €500k for 15%\"\n    ]\n  },\n  \"questions\": {\n    \"accept\": {\n      \"type\": \"score\",\n      \"instructions\": \"How likely is the investor to accept the player's offer?\",\n      \"criteria\": [\n        \"Definitely reject\",\n        \"Probably reject\",\n        \"Uncertain\",\n        \"Probably accept\",\n        \"Definitely accept\"\n      ]\n    },\n    \"reaction\": {\n      \"type\": \"choice\",\n      \"instructions\": \"How should the investor react?\",\n      \"criteria\": {\n        \"accept\": \"Accept the offer\",\n        \"counter\": \"Make a counter-offer\",\n        \"reject\": \"Reject the offer\",\n        \"walk_away\": \"End the negotiation\"\n      }\n    },\n    \"good_deal\": {\n      \"type\": \"noul\",\n      \"instructions\": \"The player's offer is attractive enough for the investor\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
