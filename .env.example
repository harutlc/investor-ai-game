# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development

# Secrets (required, >= 32 chars, must differ). Generate with:
#   openssl rand -base64 48
COOKIE_SECRET=
CSRF_SECRET=

# Optional overrides of config/app.config.json
PORT=
CORS_ORIGINS=
DATABASE_FILE=
LOG_LEVEL=
# Path to an alternative config file (relative to the repo root)
APP_CONFIG_PATH=
