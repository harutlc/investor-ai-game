# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development

# Secrets (>= 32 chars). Generate with:
#   openssl rand -base64 48
COOKIE_SECRET=
# Only needed when CSRF protection is enabled (must differ from COOKIE_SECRET)
CSRF_SECRET=
# true | false, overrides security.csrf.enabled (false in the committed config)
CSRF_ENABLED=

# Optional overrides of config/app.config.json
PORT=
CORS_ORIGINS=
DATABASE_FILE=
LOG_LEVEL=
# Path to an alternative config file (relative to the repo root)
APP_CONFIG_PATH=

# --- LLM providers (see llm.* in config/app.config.json) ---
# Active providers: thinking = ollama | anthropic | fake, decision = jev | laya | fake
THINKING_PROVIDER=ollama
DECISION_PROVIDER=jev
# Endpoints
OLLAMA_BASE_URL=http://localhost:11434
LAYA_BASE_URL=
# Keys: only the active provider's key is required (Laya's is optional)
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
LAYA_API_KEY=
