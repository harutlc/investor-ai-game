# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development

# Secrets (>= 32 chars). Generate with:
#   openssl rand -base64 48
COOKIE_SECRET=
# Only needed when CSRF protection is enabled (must differ from COOKIE_SECRET)
CSRF_SECRET=
# true | false, overrides security.csrf.enabled (false in the committed config)
CSRF_ENABLED=

# Optional overrides of config/app.config.json
PORT=
# Proxies to trust for the client IP: false (default) | hop count | comma list of addresses/CIDRs
TRUST_PROXY=
CORS_ORIGINS=
# sqlite (default) | postgres | mysql, overrides database.dialect
DATABASE_DIALECT=
# SQLite file, used only by the sqlite dialect
DATABASE_FILE=
# Secret. Required for postgres/mysql, e.g. postgres://user:pass@localhost:5432/game or mysql://user:pass@localhost:3306/game
DATABASE_URL=
# fatal | error | warn | info | debug | trace | silent. Unset: debug in development, info otherwise
LOG_LEVEL=
# true logs full LLM prompts and responses (players' text included). Debugging only, never in production
LOG_LLM_CONTENT=
# Path to an alternative config file (relative to the repo root)
APP_CONFIG_PATH=

# --- LLM providers (see llm.* in config/app.config.json) ---
# Active providers: thinking = ollama | anthropic | fake, decision = jev | laya | fake
THINKING_PROVIDER=ollama
DECISION_PROVIDER=jev
# Endpoints
OLLAMA_BASE_URL=http://localhost:11434
LAYA_BASE_URL=
# Keys: only the active provider's key is required (Laya's is optional)
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
LAYA_API_KEY=

# --- Docker Compose (docker-compose.yml) ---
# Read by Compose only; the containers' own values. Unset = the defaults shown.
# production | development (development allows fake providers and non-Secure cookies over plain HTTP)
DOCKER_NODE_ENV=
# Providers running on the host, as seen from the api container
DOCKER_OLLAMA_BASE_URL=
DOCKER_LAYA_BASE_URL=
# Host port for the web UI (default 8080)
WEB_PORT=

# --- Sentry (project investor-api) ---
# Empty: the SDK stays disabled. Release defaults to unset; the deploy sets it to the image tag.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
